{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "mcp__claude-in-chrome",
      "mcp__playwright-chromium-browser__browser_close"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "skills@fsw0422": false,
    "playwright-chromium-browser@fsw0422": false
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "iterm2",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__playwright-chromium-browser__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.ksp/skills/playwright-chromium-browser/browser.sh\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
